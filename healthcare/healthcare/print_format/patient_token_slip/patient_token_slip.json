 "font": "Default",
 "html": "<style>\n.token-slip { width: 72mm; margin: 0 auto; text-align: center; font-family: sans-serif; color: #000; }\n.token-slip .facility { font-size: 14px; font-weight: 600; margin-bottom: 4px; }\n.token-slip .token-label { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin-top: 10px; }\n.token-slip .token-no { font-size: 56px; font-weight: 700; line-height: 1.1; }\n.token-slip .row-line { font-size: 13px; margin: 3px 0; }\n.token-slip hr { border: 0; border-top: 1px dashed #000; margin: 10px 0; }\n</style>\n<div class=\"token-slip\">\n  <div class=\"facility\">{{ doc.facility_name or \"\" }}</div>\n  <hr>\n  <div class=\"token-label\">{{ _(\"Your Token\") }}</div>\n  <div class=\"token-no\">{{ doc.token_number }}</div>\n  <hr>\n  <div class=\"row-line\"><strong>{{ _(\"UHID\") }}:</strong> {{ doc.patient }}</div>\n  <div class=\"row-line\"><strong>{{ _(\"Name\") }}:</strong> {{ doc.patient_name }}</div>\n  <div class=\"row-line\"><strong>{{ _(\"Date\") }}:</strong> {{ doc.get_formatted(\"token_date\") }}</div>\n</div>",
